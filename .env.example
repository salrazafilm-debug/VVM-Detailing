# Set these in Vercel: Project > Settings > Environment Variables. Never commit real values.
# Square (prices and times come from Square)
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=production
# request = customer picks an open time and you get an email to confirm in Square (works on Square Free).
BOOKING_MODE=request
SQUARE_LOCATION_ID=
SQUARE_TEAM_MEMBER_ID=
MIN_NOTICE_HOURS=12
MAX_DAYS_AHEAD=365

# Supabase (holds for booked times). SECRET key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.vvmdetails.com

# Brevo maintenance messages (template IDs are configured in Brevo)
BREVO_API_KEY=
BREVO_MONTH1_TEMPLATE_ID=
BREVO_MONTH3_TEMPLATE_ID=
GARAGE_REMINDER_SECRET=
CRON_SECRET=

# Resend (booking request emails). Without it, bookings fail loudly instead of disappearing.
RESEND_API_KEY=
BOOKING_TO=vvm.detailing@gmail.com
BOOKING_FROM=VVM Details <onboarding@resend.dev>

# Optional: Google reviews on the Reviews section (the owner's own reviews live in public/reviews.json).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Customer address for the KIMBEACH160 coupon (kept out of the code on purpose).
KIMBEACH160_ADDRESS=
# Kim's contact details for the welcome summary (private, never in the code).
KIMBEACH160_PHONE=
KIMBEACH160_EMAIL=
